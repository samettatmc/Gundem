{
  "name": "gundem",
  "productName": "Gündem",
  "version": "1.0.0",
  "description": "Kişisel görev ve gün planlama uygulaması",
  "author": "Samet",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "web": "node scripts/copy-web.js",
    "start": "node scripts/copy-web.js && electron ."
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.17.0",
    "@capacitor/cli": "7.6.9",
    "@capacitor/core": "7.6.9",
    "@capacitor/android": "7.6.9",
    "@capacitor-community/speech-recognition": "7.0.1",
    "@capacitor/assets": "3.0.5"
  },
  "build": {
    "appId": "com.samet.gundem",
    "productName": "Gündem",
    "files": ["electron/**", "www/**", "package.json"],
    "directories": { "output": "dist", "buildResources": "build" },
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gündem",
      "artifactName": "Gundem-Kurulum-${version}.${ext}"
    },
    "publish": [{ "provider": "github", "releaseType": "release" }]
  }
}
